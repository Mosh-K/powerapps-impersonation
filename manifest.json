{
  "manifest_version": 3,
  "name": "PowerApps Impersonation",
  "version": "1.0.0",
  "description": "Impersonate Dataverse users in PowerApps and Dynamics 365",
  "permissions": [
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.powerapps.com/*",
    "*://*.dynamics.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PowerApps Impersonation",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
